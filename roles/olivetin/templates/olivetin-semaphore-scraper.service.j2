# Managed by Ansible — role: brcak_zmaj.almir_ansible.olivetin
[Unit]
Description=OliveTin Semaphore action-button scraper
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
{% if olivetin_semaphore_creds_available %}
LoadCredentialEncrypted=semaphore_api_token:{{ olivetin_semaphore_token_cred_file }}
{% else %}
EnvironmentFile={{ olivetin_semaphore_token_env_file }}
{% endif %}
ExecStart={{ olivetin_semaphore_scraper_script_path_resolved }}
