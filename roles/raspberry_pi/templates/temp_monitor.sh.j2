#!/bin/bash
# {{ ansible_managed }}
# Raspberry Pi Temperature Monitor
#
# Runs every few minutes via cron. Routine readings are NOT written to disk -
# only threshold-crossing events are, to keep SD card writes near zero on a
# quiet system. Every reading still goes to the journal via logger, which is
# volatile (RAM-only) storage on this role's journald config, so it costs no
# SD card wear either way.

TEMP_LOG="/var/log/rpi-temp/temperature.log"
WARNING_TEMP={{ rpi_temp_warning | default(70) }}
CRITICAL_TEMP={{ rpi_temp_critical | default(80) }}
THROTTLE_TEMP={{ rpi_temp_throttle | default(85) }}
MAX_LOG_LINES=1000

if command -v vcgencmd >/dev/null 2>&1; then
    TEMP=$(vcgencmd measure_temp | grep -oE '[0-9]+\.[0-9]+')
    TEMP_INT=${TEMP%.*}
    TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

    if [ "$TEMP_INT" -ge "$THROTTLE_TEMP" ]; then
        MSG="CRITICAL: Temperature ${TEMP}°C exceeds throttle threshold ${THROTTLE_TEMP}°C"
        logger -p crit "RPi Temperature CRITICAL: ${TEMP}°C"
        echo "[$TIMESTAMP] $MSG" >> "$TEMP_LOG"
    elif [ "$TEMP_INT" -ge "$CRITICAL_TEMP" ]; then
        MSG="WARNING: Temperature ${TEMP}°C exceeds critical threshold ${CRITICAL_TEMP}°C"
        logger -p warn "RPi Temperature WARNING: ${TEMP}°C"
        echo "[$TIMESTAMP] $MSG" >> "$TEMP_LOG"
    elif [ "$TEMP_INT" -ge "$WARNING_TEMP" ]; then
        MSG="NOTICE: Temperature ${TEMP}°C exceeds warning threshold ${WARNING_TEMP}°C"
        logger -p notice "RPi Temperature: ${TEMP}°C"
        echo "[$TIMESTAMP] $MSG" >> "$TEMP_LOG"
    else
        logger -p info "RPi Temperature: ${TEMP}°C"
    fi
fi

# Trim the log only once it's actually grown past the cap, not on every run.
if [ -f "$TEMP_LOG" ] && [ "$(wc -l < "$TEMP_LOG")" -gt "$MAX_LOG_LINES" ]; then
    tail -n "$MAX_LOG_LINES" "$TEMP_LOG" > "$TEMP_LOG.tmp" && mv "$TEMP_LOG.tmp" "$TEMP_LOG"
fi
